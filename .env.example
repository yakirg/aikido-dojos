# Copy to .env and fill in. .env is gitignored.
POSTGRES_PASSWORD=change-me

# Admin created on first start when no admins exist (blank = random password printed once in `docker compose logs app`)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Host ports (bound to 127.0.0.1 only)
APP_PORT=8090
DB_PORT=5432

# Optional: admin email notifications
APP_PUBLIC_URL=
APP_MAIL_FROM=
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
