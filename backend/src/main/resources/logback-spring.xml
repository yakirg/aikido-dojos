<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <springProperty scope="context" name="AUDIT_LOG" source="app.audit-log" defaultValue="logs/audit.log"/>

    <!-- Audit trail: one append-only file, never rotated or deleted by the app. Never contains passwords. -->
    <appender name="AUDIT_FILE" class="ch.qos.logback.core.FileAppender">
        <file>${AUDIT_LOG}</file>
        <append>true</append>
        <immediateFlush>true</immediateFlush>
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="audit" level="INFO" additivity="true">
        <appender-ref ref="AUDIT_FILE"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
